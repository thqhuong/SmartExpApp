# AI_WORKER_URL: Public Cloudflare Worker URL for all AI features.
# Do not put provider API tokens in the Android app or this file.
AI_WORKER_URL="https://smart-exp-recipe-images.YOUR_SUBDOMAIN.workers.dev"

# RECIPE_IMAGE_WORKER_URL: Optional. Public Cloudflare Worker URL for recipe images.
# Defaults to AI_WORKER_URL when omitted.
RECIPE_IMAGE_WORKER_URL="https://smart-exp-recipe-images.YOUR_SUBDOMAIN.workers.dev"

# PRODUCT_PARSER_WORKER_URL: Optional. Public Cloudflare Worker URL for Smart Add parsing.
# Defaults to AI_WORKER_URL when omitted because all endpoints can share one Worker.
PRODUCT_PARSER_WORKER_URL="https://smart-exp-recipe-images.YOUR_SUBDOMAIN.workers.dev"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
