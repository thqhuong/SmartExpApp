<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow layer -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#40EF4444" />
            <stroke
                android:width="4dp"
                android:color="#1AEF4444" />
        </shape>
    </item>
    <!-- Solid red circle -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#BA1A1A" />
            <stroke
                android:width="1dp"
                android:color="#FF8A80" />
        </shape>
    </item>
</layer-list>
