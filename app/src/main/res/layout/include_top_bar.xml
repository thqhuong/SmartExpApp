<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/topBar"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_glass_header"
    android:elevation="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <ImageButton
        android:id="@+id/topActionMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/app_name"
        android:padding="10dp"
        android:scaleType="center"
        android:src="@drawable/ic_menu_three_lines"
        android:visibility="gone"
        android:layout_marginEnd="8dp"
        app:tint="@color/smart_primary_container" />

    <TextView
        android:id="@+id/topTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="0dp"
        android:text="@string/app_name_chrome"
        android:textColor="@color/smart_primary_container"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Archive Button (History) -->
    <FrameLayout
        android:id="@+id/topActionArchive"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_search_circle"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:contentDescription="@string/history_title">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_archive"
            android:contentDescription="@string/history_title" />
    </FrameLayout>

    <!-- Theme Toggle Pill Container -->
    <LinearLayout
        android:id="@+id/themeTogglePill"
        android:layout_width="72dp"
        android:layout_height="36dp"
        android:layout_marginEnd="0dp"
        android:background="@drawable/bg_theme_toggle_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="2dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/toggle_theme">

        <!-- Light Mode Button (Sun) -->
        <FrameLayout
            android:id="@+id/btnToggleLightMode"
            android:importantForAccessibility="no"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <!-- Active Orange Circle Background -->
            <View
                android:id="@+id/themeToggleSunBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_theme_active_circle"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/themeToggleSunIcon"
                android:importantForAccessibility="no"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:padding="6dp"
                android:src="@drawable/ic_theme_sun" />
        </FrameLayout>

        <!-- Dark Mode Button (Moon) -->
        <FrameLayout
            android:id="@+id/btnToggleDarkMode"
            android:importantForAccessibility="no"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <!-- Active Orange Circle Background -->
            <View
                android:id="@+id/themeToggleMoonBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_theme_active_circle"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/themeToggleMoonIcon"
                android:importantForAccessibility="no"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:padding="6dp"
                android:src="@drawable/ic_theme_moon" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
