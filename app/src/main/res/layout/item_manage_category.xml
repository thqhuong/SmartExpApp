<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <View
        android:id="@+id/categoryDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_category_dot" />

    <TextView
        android:id="@+id/categoryName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/smart_on_surface" />

    <ImageButton
        android:id="@+id/btnEditCategory"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/rename_label"
        android:padding="10dp"
        android:scaleType="center"
        android:src="@drawable/ic_edit"
        app:tint="@color/smart_muted" />

    <ImageButton
        android:id="@+id/btnDeleteCategory"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete_confirm"
        android:padding="10dp"
        android:scaleType="center"
        android:src="@drawable/ic_delete"
        app:tint="@color/smart_error" />

</LinearLayout>
