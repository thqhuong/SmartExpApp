<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:padding="16dp">

    <!-- Hero Image Area -->
    <FrameLayout
        android:id="@+id/recipeHero"
        android:layout_width="match_parent"
        android:layout_height="192dp"
        android:background="@drawable/bg_hero_neutral"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/recipeIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/recipeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/smart_on_surface"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Description -->
    <TextView
        android:id="@+id/recipeSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/smart_secondary"
        android:textSize="14sp" />

    <!-- Ingredients Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:text="EXPIRING INGREDIENTS"
        android:textColor="@color/smart_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Ingredient list container -->
    <LinearLayout
        android:id="@+id/ingredientList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/recipeAction"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:cornerRadius="24dp"
        app:icon="@android:drawable/ic_media_play"
        app:iconGravity="textStart" />
</LinearLayout>
