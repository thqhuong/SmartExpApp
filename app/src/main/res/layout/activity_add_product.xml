<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_screen"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false">

    <include layout="@layout/include_top_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/addProductTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_product"
                android:textColor="@color/smart_on_surface"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/addProductSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:text="@string/add_product_subtitle"
                android:textColor="@color/smart_secondary"
                android:textSize="14sp" />

            <!-- AI-assisted Smart Add Card -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/smart_add_section"
                android:textColor="@color/smart_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_gemini_icon_gradient">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_gemini_sparkles"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/smart_add_title"
                            android:textColor="@color/smart_on_surface"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/smart_add_desc"
                            android:textColor="@color/smart_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLaunchGeminiLive"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_gemini_launch_button"
                    app:backgroundTint="@null"
                    android:text="@string/start_voice_add"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_mic"
                    app:iconGravity="textStart"
                    app:iconTint="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypeSmartAdd"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/smart_surface_container"
                    android:text="@string/type_smart_add"
                    android:textAllCaps="false"
                    android:textColor="@color/smart_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="24dp"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:iconGravity="textStart"
                    app:iconTint="@color/smart_on_surface" />
            </LinearLayout>

            <!-- Glass Panel Form Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_panel"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/product_name_label"
                    android:textColor="@color/smart_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/productNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_glass_input"
                    android:hint="@string/product_name_hint"
                    android:inputType="textCapWords"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@color/smart_on_surface"
                    android:textColorHint="@color/smart_secondary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/quantity_label"
                    android:textColor="@color/smart_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/quantityInput"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_glass_input"
                        android:inputType="numberDecimal"
                        android:hint="@string/quantity_default"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="@color/smart_on_surface"
                        android:textColorHint="@color/smart_secondary"
                        android:textSize="16sp" />

                    <Spinner
                        android:id="@+id/unitSpinner"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_input"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                        android:text="@string/category_label"
                    android:textColor="@color/smart_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/categorySpinner"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_input"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnManageCategories"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="@string/manage_label"
                        android:textColor="@color/smart_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/smart_primary_soft"
                        app:cornerRadius="24dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/storage_method_label"
                    android:textColor="@color/smart_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/storageGroup"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_toggle_group"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:id="@+id/storageRoom"
                        style="@style/SmartExpStorageOption"
                        android:background="@drawable/bg_storage_option_room">

                        <ImageView
                            style="@style/SmartExpStorageIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_storage_room"
                            app:tint="@color/color_storage_room_tint" />

                        <TextView
                            style="@style/SmartExpStorageLabel"
                            android:textColor="@color/color_storage_room_tint"
                            android:text="@string/storage_room_temp_upper" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/storageFridge"
                        style="@style/SmartExpStorageOption"
                        android:background="@drawable/bg_storage_option_fridge">

                        <ImageView
                            style="@style/SmartExpStorageIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_storage_fridge"
                            app:tint="@color/color_storage_fridge_tint" />

                        <TextView
                            style="@style/SmartExpStorageLabel"
                            android:textColor="@color/color_storage_fridge_tint"
                            android:text="@string/storage_refrigerator_upper" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/storageFreezer"
                        style="@style/SmartExpStorageOption"
                        android:background="@drawable/bg_storage_option_freezer">

                        <ImageView
                            style="@style/SmartExpStorageIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_storage_freeze"
                            app:tint="@color/color_storage_freezer_tint" />

                        <TextView
                            style="@style/SmartExpStorageLabel"
                            android:textColor="@color/color_storage_freezer_tint"
                            android:text="@string/storage_freeze_upper" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/expiry_date_label"
                    android:textColor="@color/smart_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_glass_input"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/expiryDateInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:contentDescription="@string/select_expiry_date"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/select_expiry_date"
                        android:textColor="@color/smart_secondary"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/smart_surface_variant" />

                    <ImageButton
                        android:id="@+id/btnOcrScan"
                        android:layout_width="52dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/scan_with_camera"
                        android:padding="14dp"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="@color/smart_primary" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/photo_optional_label"
                    android:textColor="@color/smart_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/photoPreview"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_glass_input"
                        android:clickable="true"
                        android:contentDescription="@string/add_product_photo_desc"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:id="@+id/productPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/photoPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:importantForAccessibility="no"
                            android:src="@android:drawable/ic_menu_gallery"
                                app:tint="@color/smart_muted" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/tap_add_photo"
                                android:textColor="@color/smart_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/editIconOverlay"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_glass_shadow"
                            android:padding="5dp"
                            android:importantForAccessibility="no"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="@color/smart_primary_container"
                            android:visibility="gone" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRemovePhoto"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="@string/remove_photo"
                        android:textAllCaps="false"
                        android:textColor="@color/smart_error"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:backgroundTint="@color/smart_error_container"
                        app:cornerRadius="22dp"
                        app:icon="@android:drawable/ic_menu_delete"
                        app:iconGravity="textStart"
                        app:iconTint="@color/smart_error" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/skipSmartDraftButton"
                    android:layout_width="104dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:text="@string/skip_label"
                    android:textAllCaps="false"
                    android:textColor="@color/smart_primary_container"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="28dp"
                    app:strokeColor="@color/smart_primary_container"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addProductButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="@string/add_product"
                    android:textAllCaps="false"
                    android:textColor="@color/smart_on_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/smart_primary_container"
                    app:cornerRadius="28dp"
                    app:icon="@android:drawable/ic_menu_add"
                    app:iconGravity="textStart"
                    app:iconTint="@color/smart_on_primary" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
