<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/smart_background"
    android:orientation="vertical">

    <include layout="@layout/include_top_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Product"
                android:textColor="@color/smart_on_surface"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="22dp"
                android:text="Enter details to track expiration."
                android:textColor="@color/smart_secondary"
                android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/smart_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@color/smart_surface_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PRODUCT NAME"
                        android:textColor="@color/smart_on_surface"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/productNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/bg_surface_low"
                        android:hint="e.g., Organic Milk"
                        android:inputType="textCapWords"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="@color/smart_on_surface"
                        android:textColorHint="@color/smart_secondary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="STORAGE METHOD"
                        android:textColor="@color/smart_on_surface"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/storageGroup"
                        android:layout_width="match_parent"
                        android:layout_height="112dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/bg_toggle_group"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:id="@+id/storageRoom"
                            style="@style/SmartExpStorageOption">

                            <ImageView
                                style="@style/SmartExpStorageIcon"
                                android:src="@drawable/ic_storage_room"
                                app:tint="@color/storage_option_tint" />

                            <TextView
                                style="@style/SmartExpStorageLabel"
                                android:text="ROOM\nTEMP" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/storageFridge"
                            style="@style/SmartExpStorageOption">

                            <ImageView
                                style="@style/SmartExpStorageIcon"
                                android:src="@drawable/ic_storage_fridge"
                                app:tint="@color/storage_option_tint" />

                            <TextView
                                style="@style/SmartExpStorageLabel"
                                android:text="REFRIGERATOR" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/storageFreezer"
                            style="@style/SmartExpStorageOption">

                            <ImageView
                                style="@style/SmartExpStorageIcon"
                                android:src="@drawable/ic_storage_freeze"
                                app:tint="@color/storage_option_tint" />

                            <TextView
                                style="@style/SmartExpStorageLabel"
                                android:text="FREEZE" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="EXPIRY DATE"
                        android:textColor="@color/smart_on_surface"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/expiryDateInput"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_surface_low"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Select expiry date"
                        android:textColor="@color/smart_secondary"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addProductButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Add Product"
                android:textAllCaps="false"
                android:textColor="@color/smart_on_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/smart_primary_container"
                app:cornerRadius="28dp"
                app:icon="@android:drawable/ic_menu_add"
                app:iconGravity="textStart"
                app:iconTint="@color/smart_on_primary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
