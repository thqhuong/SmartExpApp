<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glass background -->
    <item>
        <shape>
            <solid android:color="@color/smart_glass_surface" />
        </shape>
    </item>
    <!-- Inner edge glow (top and sides only) -->
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="0dp">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/smart_glass_inner_glow" />
        </shape>
    </item>
    <!-- Bottom border only -->
    <item android:left="-2dp" android:right="-2dp" android:top="-2dp">
        <shape>
            <stroke
                android:width="1.5dp"
                android:color="@color/smart_glass_stroke" />
        </shape>
    </item>
</layer-list>
