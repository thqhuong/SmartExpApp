<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid background -->
    <item>
        <shape>
            <solid android:color="@color/multi_select_bar_bg" />
        </shape>
    </item>
    <!-- Bottom border only -->
    <item android:left="-2dp" android:right="-2dp" android:top="-2dp">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/multi_select_bar_stroke" />
        </shape>
    </item>
</layer-list>
