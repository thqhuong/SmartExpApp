<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/smart_glass_surface_strong" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/smart_glass_inner_glow" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/smart_glass_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
