<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/dialog_input_bg_focused" />
            <stroke
                android:width="2dp"
                android:color="@color/dialog_input_border_focused" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/dialog_input_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/dialog_input_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
