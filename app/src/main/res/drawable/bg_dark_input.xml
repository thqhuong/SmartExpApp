<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#2D2D31" />
            <stroke
                android:width="2dp"
                android:color="@color/smart_primary_container" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1F1F22" />
            <stroke
                android:width="1dp"
                android:color="#45FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
