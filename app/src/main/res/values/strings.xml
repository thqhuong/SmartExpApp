    <string name="support_title">Support</string>
    <string name="support_intro_title">Help that matches this app</string>
    <string name="support_intro_body">Quick answers for inventory tracking, reminders, recipe suggestions, and local data.</string>
    <string name="support_faq_section">Frequently asked questions</string>
    <string name="support_faq_add_title">How do I add or update products?</string>
    <string name="support_faq_add_body">Use the add button to save a product name, quantity, storage location, category, and expiry date. Open an item from Inventory to edit, mark used, archive, or delete it.</string>
    <string name="support_faq_reminders_title">Why am I not receiving expiry reminders?</string>
    <string name="support_faq_reminders_body">Check Notification Settings, then allow SmartExpApp notifications in Android settings. Reminders run locally and use the reminder day and time saved on this device.</string>
    <string name="support_faq_recipes_title">Do recipe suggestions require AI?</string>
    <string name="support_faq_recipes_body">No. SmartExpApp can suggest recipes from local inventory data. If Cloudflare AI is configured, it can improve suggestions; otherwise local fallback stays available.</string>
    <string name="support_faq_data_title">Where is my data stored?</string>
    <string name="support_faq_data_body">Inventory, scans, recipes, and reminder settings are stored in the app database on this device. Signed-in data can sync when Firebase is configured and sync is active.</string>
    <string name="support_contact_section">Contact and diagnostics</string>
    <string name="support_contact_body">Open your email app with app details included. Add the team support address before sending.</string>
